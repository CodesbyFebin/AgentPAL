# --- AI coach (OpenAI-compatible). If AI_API_KEY is unset, AgentPaL uses the labelled offline coach. ---
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# --- PayPal REST (Orders v2, intent=AUTHORIZE; Subscriptions cancel). If credentials are unset, labelled Mock PayPal mode is used. ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=

# Public URL used for PayPal return/cancel redirects
APP_URL=http://localhost:3000

# --- Braintree (preferred payment rail when all three keys are set). Private key is server-only. ---
BRAINTREE_MERCHANT_ID=
BRAINTREE_PUBLIC_KEY=
BRAINTREE_PRIVATE_KEY=
BRAINTREE_ENV=sandbox

# Required when PayPal, Braintree, or AI secrets are configured.
# Generate a unique owner key of at least 32 characters and keep it server-side.
AGENTPAL_OWNER_KEY=
# Optional. An owner can send capped payouts to this fixed PayPal sandbox test account.
AGENTPAL_PAYOUT_SANDBOX_EMAIL=
