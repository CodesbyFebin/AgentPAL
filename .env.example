# --- AI planner (OpenAI-compatible). If AI_API_KEY is unset, MeshPaL uses the offline planner. ---
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# --- PayPal REST (Orders v2, intent=AUTHORIZE). If credentials are unset, MeshPaL uses clearly labeled mock PayPal mode. ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Public URL used for PayPal return/cancel redirects
APP_URL=http://localhost:3000
